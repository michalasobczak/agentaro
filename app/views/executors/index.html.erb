<%= page_header "Executors", "AI tools Agentaro can use: programs logged in on this computer, or local servers that need no key." do %>
  <% if current_user.admin? %>
    <%= link_to new_admin_executor_path, class: "button desktop-only" do %><%= icon(:plus) %> New executor<% end %>
  <% end %>
<% end %>
<% if @executors.empty? %>
  <div class="card"><p class="muted">No executors yet.<% if current_user.admin? %> Add one from a preset: Claude Code, Codex, Gemini, Grok, Ollama or LM Studio.<% end %></p></div>
<% else %>
  <div class="card card-flush">
    <div class="table-wrap">
      <table class="executors">
        <thead><tr><th>Name</th><th>Kind</th><th>Preset</th><th>Default model</th><th>Status</th><th>Last check</th><% if current_user.admin? %><th class="desktop-only"></th><% end %></tr></thead>
        <tbody>
          <% @executors.each do |executor| %>
            <tr>
              <td><strong><%= executor.name %></strong></td>
              <td><%= badge(executor.cli? ? "CLI" : "API") %></td>
              <td><%= executor.label %></td>
              <td><%= executor.default_model || tag.span("—", class: "muted") %></td>
              <td><%= executor.enabled? ? badge("enabled", "ok") : badge("disabled") %></td>
              <td class="nowrap">
                <% if executor.last_checked_at %>
                  <%= executor.last_check_ok? ? badge("answers", "ok") : badge("failed", "bad") %>
                  <span class="muted small"><%= l executor.last_checked_at, format: :short %></span>
                <% else %>
                  <span class="muted">never</span>
                <% end %>
              </td>
              <% if current_user.admin? %>
                <td class="desktop-only">
                  <div class="row-actions">
                    <%= button_to "Check", check_admin_executor_path(executor), class: "secondary small" %>
                    <%= link_to "Edit", edit_admin_executor_path(executor), class: "button secondary small" %>
                  </div>
                </td>
              <% end %>
            </tr>
            <% if current_user.admin? && executor.last_check_output.present? %>
              <tr class="check-output desktop-only"><td colspan="7"><pre><%= executor.last_check_output %></pre></td></tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
<p class="muted small">Subscriptions are used by logging in on this computer (for example <code>claude login</code>, <code>codex login</code>); Agentaro stores no keys or tokens.</p>
