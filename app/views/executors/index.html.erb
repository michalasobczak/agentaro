<%= page_header "Executors", "AI tools Agentaro can use: programs logged in on this computer, or local servers that need no key." do %>
  <% if current_user.admin? %>
    <%= link_to new_admin_executor_path, class: "button desktop-only" do %><%= icon(:plus) %> New executor<% end %>
  <% end %>
<% end %>
<%# Spec 053, G1, G7: one setting for every command-line run of this account. %>
<section class="card sandbox-card" aria-labelledby="sandbox-title">
  <div class="sandbox-head">
    <h2 id="sandbox-title" class="sandbox-title">Relaxed sandbox <%= current_user.relaxed_sandbox? ? badge("on", "ok") : badge("off") %></h2>
    <%= button_to (current_user.relaxed_sandbox? ? "Turn off" : "Turn on"), account_relaxed_sandbox_path(on: current_user.relaxed_sandbox? ? 0 : 1),
                  method: :patch, class: "secondary small" %>
  </div>
  <p class="small">Command-line agents (Claude Code, Codex) always work in a sandbox. With this on, every run — steps, the director and the verifier — may also
    <strong>open any web page</strong>, <strong>open local ports</strong> (to start and check its own server), and use <strong>Git</strong>:
    before a step in a space's folder without a repository, Agentaro creates one (no hooks).</p>
  <p class="small muted">Always denied: reading Agentaro's storage (databases, secrets), other spaces' folders and other runs; writing outside the folder and temporary folders. Codex cannot limit reads (accepted, spec 018). With network access an agent can send what it sees to any host.</p>
</section>
<% if @executors.empty? %>
  <div class="card"><p class="muted">No executors yet.<% if current_user.admin? %> Add one from a preset: Claude Code, Codex, Gemini, Grok, Ollama or LM Studio.<% end %></p></div>
<% else %>
  <div class="card card-flush">
    <div class="table-wrap">
      <table class="executors">
        <thead><tr><th>Name</th><th>Kind</th><th>Preset</th><th>Default model</th><th>Status</th><th>Usage limit</th><th>Last check</th><% if current_user.admin? %><th class="desktop-only"></th><% end %></tr></thead>
        <tbody>
          <% @executors.each do |executor| %>
            <tr>
              <td><strong><%= executor.name %></strong></td>
              <td><%= badge(executor.cli? ? "CLI" : "API") %></td>
              <td><%= executor.label %></td>
              <td><%= executor.default_model || tag.span("—", class: "muted") %></td>
              <td><%= executor.enabled? ? badge("enabled", "ok") : badge("disabled") %></td>
              <td class="usage-limit"><%= usage_limit_text(executor) %></td>
              <td class="nowrap">
                <% if executor.last_checked_at %>
                  <%= executor.last_check_ok? ? badge("answers", "ok") : badge("failed", "bad") %>
                  <span class="muted small"><%= l executor.last_checked_at, format: :short %></span>
                <% else %>
                  <span class="muted">never</span>
                <% end %>
              </td>
              <% if current_user.admin? %>
                <td class="desktop-only">
                  <div class="row-actions">
                    <%= button_to "Check", check_admin_executor_path(executor), class: "secondary small" %>
                    <%= link_to "Edit", edit_admin_executor_path(executor), class: "button secondary small" %>
                  </div>
                </td>
              <% end %>
            </tr>
            <% if current_user.admin? && executor.last_check_output.present? %>
              <tr class="check-output desktop-only"><td colspan="8"><pre><%= executor.last_check_output %></pre></td></tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
<% if @executors.any?(&:unsandboxed?) %>
  <%# Spec 055, G5, R1: said plainly wherever opencode can be chosen. %>
  <div class="callout warn opencode-note"><%= icon(:info) %><div><strong>opencode runs without a sandbox.</strong> Agents on it can read and change everything this Mac account can — Agentaro's databases and secrets, SSH keys, other projects. Free models run on opencode's servers, so what such an agent reads (its prompt, files, outputs) leaves this computer under opencode's terms.</div></div>
<% end %>
<p class="muted small">Subscriptions are used by logging in on this computer (for example <code>claude login</code>, <code>codex login</code>); Agentaro stores no keys or tokens.</p>
