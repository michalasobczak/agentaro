<%# The floating chat with the director (owner fix after spec 011): a button at the bottom right that opens
    the chat as a panel on the right. Open or closed is remembered per browser by chat.js. %>
<% writing = TaskRun.where(user: current_user, purpose: "chat", state: %w[queued running]).exists? %>
<aside class="chat-dock" data-chat-dock aria-label="Chat with <%= director.name %>">
  <button type="button" class="chat-launcher" data-dock-open aria-expanded="false" aria-controls="chat-dock-panel" title="Chat with <%= director.name %>">
    <span class="chat-avatar is-director" aria-hidden="true"><%= director.name.first.upcase %></span>
    <span class="chat-launcher-label"><%= director.name %></span>
    <span class="chat-unread" data-unread hidden aria-label="New message"></span>
  </button>
  <div class="chat-dock-panel" id="chat-dock-panel">
    <%= render "directors/chat", director: director, messages: [], writing: writing, dock: true,
               latest_reply_id: current_user.chat_messages.where.not(author: "user").maximum(:id) %>
  </div>
</aside>
