<%# The director chat (spec 011 G1). Used full page on the Director page and as the floating chat on every other page
    (dock: true). The floating chat loads its messages when first opened; chat.js drives both. %>
<% dock = local_assigns.fetch(:dock, false) %>
<% voice_ready = Voice.listening? && Voice.speaking? %>
<%# Spec 023: busy/free of the team (G4; spec 036: the load, e.g. "2/6 in progress") and the status dots on icons (R11); chat.js updates them from its poll (R12). %>
<% team_status = AgentStatus.json(current_user) %>
<% statuses = team_status[:agents].index_by { |a| a[:id] } %>
<% strip = team_status[:agents].select { |a| a[:member] } %>
<div class="chat-app<%= " is-dock" if dock %>" data-messages-url="<%= chat_messages_path %>" data-last-id="<%= messages.last&.id.to_i %>"
     data-voice="<%= voice_ready ? "ready" : "missing" %>" data-voice-transcribe-url="<%= voice_transcribe_path %>" data-voice-speak-url="<%= voice_speak_path %>"
     data-writing="<%= writing %>" data-team-stamp="<%= team_status[:stamp] %>"<% if dock %> data-lazy="true" data-latest-reply-id="<%= latest_reply_id.to_i %>"<% end %>>
  <header class="chat-head">
    <span class="chat-avatar is-director" aria-hidden="true" data-agent-icon="<%= director.id %>"><%= agent_initials(director.name) %><%= status_dot(statuses[director.id]) %></span>
    <div class="chat-who">
      <strong><%= director.name %></strong>
      <span class="chat-status muted small" data-status><%= writing ? "writing…" : "your director" %></span>
    </div>
    <%# Owner fix after spec 017: the conversation language — recognition, replies and voice. %>
    <div class="lang-switch" role="group" aria-label="Conversation language">
      <% User::CHAT_LANGUAGES.each do |code, label| %>
        <%= button_to label, chat_language_path(language: code), method: :patch, class: ["lang", ("is-active" if current_user.chat_language == code)].compact.join(" "),
                      "aria-pressed": current_user.chat_language == code,
                      title: { "auto" => "Language of your latest message", "pl" => "Polski", "en" => (Voice.english_voice? ? "English" : "English (English voice not installed: Polish voice reads it)") }[code] %>
      <% end %>
    </div>
    <%# Spec 033, G2: the owner's default autonomy level, as three buttons like the language switch (no script). %>
    <div class="lang-switch chat-autonomy" role="group" aria-label="Autonomy: how often agents ask you">
      <% Autonomy::LEVELS.each do |level, name| %>
        <%= button_to name, account_autonomy_path(level: level), method: :patch, class: ["lang", ("is-active" if current_user.autonomy_level == level)].compact.join(" "),
                      "aria-pressed": current_user.autonomy_level == level, title: Autonomy::HINTS[level] %>
      <% end %>
    </div>
    <%# Spec 029: the chat background pattern, saved on the account. chat.js saves on change (and hides Apply);
        without it the form posts normally. %>
    <% background_id = dock ? "chat-dock-background" : "chat-background" %>
    <%= form_with url: account_chat_background_path, method: :patch, class: "chat-bg", data: { chat_background_form: true } do %>
      <label class="visually-hidden" for="<%= background_id %>">Chat background</label>
      <%= select_tag :chat_background, options_for_select(User::CHAT_BACKGROUNDS.invert, current_user.shown_chat_background),
                     id: background_id, class: "chat-bg-select", title: "Chat background", data: { chat_background_select: true } %>
      <button type="submit" class="secondary chat-bg-apply" data-chat-background-apply>Apply</button>
      <span class="visually-hidden" role="status" data-chat-background-status></span>
    <% end %>
    <nav class="chat-links">
      <% if current_user.verifier_role %>
        <% on = current_user.verifier_active? %>
        <%= button_to verify_director_path, class: ["verify-tool", ("is-on" if on)].compact.join(" "), data: { verify: true }, "aria-pressed": on,
                      title: on ? "#{current_user.verifier_role.agent.name} checks every answer — click to send it away" : "Invite #{current_user.verifier_role.agent.name} to check every answer of the director until you send it away",
                      "aria-label": "Verifier" do %><%= icon(:verify) %><span class="verify-label"><%= on ? "Verifier on" : "Verifier" %></span><% end %>
      <% end %>
      <% if dock %>
        <%= button_to new_conversation_director_path, class: "chat-tool", title: "New conversation", "aria-label": "New conversation", form: { data: { confirm: "Start a new conversation? This one moves to the archive; your epics and plans stay." } } do %><%= icon(:new_chat) %><% end %>
        <%= link_to director_path, class: "chat-tool", data: { dock_max: true }, title: "Maximize the chat", "aria-label": "Maximize the chat", "aria-pressed": "false" do %><%= icon(:expand) %><% end %>
        <button type="button" class="chat-tool" data-dock-close title="Hide the chat (Esc)" aria-label="Hide the chat"><%= icon(:close) %></button>
      <% else %>
        <%= button_to new_conversation_director_path, class: "chat-tool", title: "New conversation", "aria-label": "New conversation", form: { data: { confirm: "Start a new conversation? This one moves to the archive; your epics and plans stay." } } do %><%= icon(:new_chat) %><% end %>
        <%= link_to archive_director_path, class: "chat-tool", title: "Earlier conversations", "aria-label": "Earlier conversations" do %><%= icon(:history) %><% end %>
        <%= link_to spaces_path, class: "chat-tool", title: "Spaces", "aria-label": "Spaces" do %><%= icon(:board) %><% end %>
        <%= link_to team_path, class: "chat-tool", title: "Team", "aria-label": "Team" do %><%= icon(:org) %><% end %>
      <% end %>
    </nav>
  </header>
  <% if strip.any? %>
    <div class="team-strip" data-team-strip aria-label="Team status">
      <button type="button" class="team-summary" data-team-toggle aria-expanded="false"><span data-team-count><%= team_strip_count(strip) %></span></button>
      <ul class="team-list">
        <% strip.each do |member| %>
          <%# Spec 024 (owner: "tylko inicjały… zamiast free kolorami"): initials with a coloured ring; the name and the
              state stay in the tooltip and for screen readers. %>
          <li class="team-chip is-<%= member[:status] %>" data-team-agent="<%= member[:id] %>" title="<%= member[:name] %>: <%= member[:label] %>">
            <%= agent_icon(agent_initials(member[:name]), tone: "tone-#{member[:id] % 8}", size: "strip", agent_id: member[:id], status: member) %>
            <span class="team-name visually-hidden"><%= member[:name] %></span>
            <span class="team-label visually-hidden" data-team-label><%= agent_strip_label(member) %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="chat-scroll">
    <div class="chat-stream" aria-live="polite">
      <% if messages.empty? && !dock %>
        <p class="chat-empty muted" data-empty>Say hello to <%= director.name %>. For example: "Research the best way to back up a Mac and write a one-page summary by Friday."</p>
      <% end %>
      <% day = nil %>
      <% latest_user = 0 %>
      <% messages.each do |message| %>
        <% latest_user = message.id if message.author == "user" %>
        <% data = chat_message_json(message) %>
        <% if data[:day] != day %><% day = data[:day] %><div class="chat-day" data-day="<%= day %>"><span><%= day %></span></div><% end %>
        <div class="bubble-row from-<%= message.author %>" data-id="<%= message.id %>">
          <%= chat_message_icon(data, statuses) %>
          <div class="bubble">
            <% unless message.author == "user" %><div class="bubble-name"><%= data[:name] %></div><% end %>
            <div class="bubble-text"><%= chat_text(message.content) %></div>
            <% if message.actions_summary %><div class="bubble-actions"><%= message.actions_summary %></div><% end %>
            <% if message.author != "user" && message.reply_to_id && message.reply_to_id < latest_user %><div class="bubble-earlier">Answer to an earlier message</div><% end %>
            <div class="bubble-time"><%= data[:time] %></div>
          </div>
        </div>
      <% end %>
      <div class="bubble-row from-director typing" data-typing <%= "hidden" unless writing %>>
        <div class="bubble"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
      </div>
    </div>
  </div>

  <%# Spec 017: voice mode — listening, thinking, speaking; the dots move with the state. %>
  <div class="voice-panel" data-voice-panel hidden>
    <span class="voice-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <div class="voice-info">
      <strong data-voice-state>Listening…</strong>
      <span class="muted small" data-voice-note>Speak; I send when you pause, or press Done.</span>
    </div>
    <%# Spec 035: mute the microphone without ending voice mode. The accessible name stays; aria-pressed tells the state.
        chat.js swaps the icon (both are here, one hidden) and the visible label. %>
    <button type="button" class="voice-mute" data-voice-mute aria-pressed="false" aria-label="Mute microphone" title="Mute the microphone — nothing you say is sent"><%= icon(:mic, css: "icon voice-mute-on") %><%= icon(:mic_off, css: "icon voice-mute-off") %><span class="voice-mute-label">Mute</span></button>
    <div class="speed-switch" role="group" aria-label="Speech speed" data-speed-url="<%= speech_speed_director_path %>">
      <% User::SPEECH_SPEEDS.each do |speed| %>
        <button type="button" class="speed<%= " is-active" if current_user.speech_speed.to_f == speed %>" data-speed="<%= speed %>" aria-pressed="<%= current_user.speech_speed.to_f == speed %>"><%= speed.to_s.sub(/\.0\z/, "").tr(".", ",") %>×</button>
      <% end %>
    </div>
    <% if current_user.verifier_role %><button type="button" class="voice-verify<%= " is-on" if current_user.verifier_active? %>" data-voice-verify title="Invite or send away the verifier" aria-label="Verifier" aria-pressed="<%= current_user.verifier_active? %>"><%= icon(:verify) %></button><% end %>
    <button type="button" class="voice-done" data-voice-done hidden title="I am done speaking — send now" aria-label="Done speaking, send now"><%= icon(:send) %> Done</button>
    <button type="button" class="voice-stop" data-voice-stop title="End voice mode" aria-label="End voice mode"><%= icon(:close) %></button>
    <span class="visually-hidden" role="status" data-voice-mute-status></span>
  </div>
  <%= form_with model: ChatMessage.new, url: chat_messages_path, class: "chat-composer" do |f| %>
    <%= f.text_area :content, rows: 1, maxlength: 5000, required: true, placeholder: "Message #{director.name}…", "aria-label": "Message", autofocus: !dock, id: (dock ? "chat-dock-input" : "chat-input") %>
    <button type="button" class="voice-button" data-voice-start title="<%= voice_ready ? "Talk to #{director.name}" : "Voice is not set up on this computer" %>" aria-label="Voice mode"<%= " disabled" unless voice_ready %>><%= icon(:voice) %></button>
    <button type="submit" class="send" aria-label="Send" title="Send (Enter)"><%= icon(:send) %></button>
  <% end %>
  <p class="chat-hint muted small desktop-only">Enter sends · Shift+Enter for a new line</p>
</div>
