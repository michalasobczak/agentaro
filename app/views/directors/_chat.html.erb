<%# The director chat (spec 011 G1). Used full page on the Director page and as the floating chat on every other page
    (dock: true). The floating chat loads its messages when first opened; chat.js drives both. %>
<% dock = local_assigns.fetch(:dock, false) %>
<div class="chat-app<%= " is-dock" if dock %>" data-messages-url="<%= chat_messages_path %>" data-last-id="<%= messages.last&.id.to_i %>"
     data-writing="<%= writing %>"<% if dock %> data-lazy="true" data-latest-reply-id="<%= latest_reply_id.to_i %>"<% end %>>
  <header class="chat-head">
    <span class="chat-avatar is-director" aria-hidden="true"><%= director.name.first.upcase %></span>
    <div class="chat-who">
      <strong><%= director.name %></strong>
      <span class="chat-status muted small" data-status><%= writing ? "writing…" : "your director" %></span>
    </div>
    <nav class="chat-links">
      <% if dock %>
        <%= link_to director_path, class: "chat-tool", title: "Open the full chat", "aria-label": "Open the full chat" do %><%= icon(:expand) %><% end %>
        <button type="button" class="chat-tool" data-dock-close title="Hide the chat (Esc)" aria-label="Hide the chat"><%= icon(:close) %></button>
      <% else %>
        <%= link_to spaces_path, class: "button secondary small" do %><%= icon(:board) %> Spaces<% end %>
        <%= link_to team_path, class: "button secondary small" do %><%= icon(:org) %> Team<% end %>
      <% end %>
    </nav>
  </header>

  <div class="chat-scroll">
    <div class="chat-stream" aria-live="polite">
      <% if messages.empty? && !dock %>
        <p class="chat-empty muted" data-empty>Say hello to <%= director.name %>. For example: "Research the best way to back up a Mac and write a one-page summary by Friday."</p>
      <% end %>
      <% day = nil %>
      <% messages.each do |message| %>
        <% data = chat_message_json(message) %>
        <% if data[:day] != day %><% day = data[:day] %><div class="chat-day" data-day="<%= day %>"><span><%= day %></span></div><% end %>
        <div class="bubble-row from-<%= message.author %>" data-id="<%= message.id %>">
          <div class="bubble">
            <% unless message.author == "user" %><div class="bubble-name"><%= data[:name] %></div><% end %>
            <div class="bubble-text"><%= message.content %></div>
            <% if message.actions_summary %><div class="bubble-actions"><%= message.actions_summary %></div><% end %>
            <div class="bubble-time"><%= data[:time] %></div>
          </div>
        </div>
      <% end %>
      <div class="bubble-row from-director typing" data-typing <%= "hidden" unless writing %>>
        <div class="bubble"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
      </div>
    </div>
  </div>

  <%= form_with model: ChatMessage.new, url: chat_messages_path, class: "chat-composer" do |f| %>
    <%= f.text_area :content, rows: 1, maxlength: 5000, required: true, placeholder: "Message #{director.name}…", "aria-label": "Message", autofocus: !dock, id: (dock ? "chat-dock-input" : "chat-input") %>
    <button type="submit" class="send" aria-label="Send" title="Send (Enter)"><%= icon(:send) %></button>
  <% end %>
  <p class="chat-hint muted small desktop-only">Enter sends · Shift+Enter for a new line</p>
</div>
