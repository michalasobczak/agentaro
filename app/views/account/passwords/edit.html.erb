<%= page_header "Change password", "Changing your password signs you out on every device." %>
<div class="card">
  <% if @errors.present? %><ul class="errors"><% @errors.each do |e| %><li><%= e %></li><% end %></ul><% end %>
  <%= form_with url: account_password_path, method: :patch, class: "form" do |f| %>
    <div class="field"><%= f.label :current_password %><%= f.password_field :current_password, required: true, autocomplete: "current-password" %></div>
    <div class="field">
      <%= f.label :password, "New password" %>
      <%= f.password_field :password, required: true, autocomplete: "new-password", minlength: User::PASSWORD_MIN %>
      <span class="hint">At least <%= User::PASSWORD_MIN %> characters. A few unrelated words work well.</span>
    </div>
    <div class="field"><%= f.label :password_confirmation, "Repeat new password" %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
    <div><%= f.submit "Change password" %></div>
  <% end %>
</div>
