<% if space.errors.any? %><ul class="errors"><% space.errors.full_messages.each do |e| %><li><%= e %></li><% end %></ul><% end %>
<%= form_with model: space, class: "form space-form" do |f| %>
  <fieldset class="field kind-choice">
    <legend>Kind</legend>
    <label class="kind-option"><%= f.radio_button :kind, "project" %><span><strong>Project space</strong><span class="hint">Works towards a goal, e.g. a renovation or a launch.</span></span></label>
    <label class="kind-option"><%= f.radio_button :kind, "team" %><span><strong>Team space</strong><span class="hint">No goal: takes care of ongoing work, e.g. household or support.</span></span></label>
  </fieldset>
  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, required: true, maxlength: 60, placeholder: "e.g. House renovation" %>
  </div>
  <div class="field goal-field">
    <%= f.label :goal %>
    <%= f.text_area :goal, rows: 3, maxlength: 2000, placeholder: "What you want to achieve in this space." %>
    <span class="hint">Required for a project space. Every agent working on an epic of this space reads it — and nothing from your other spaces.</span>
  </div>
  <div class="field">
    <%= f.label :description, "Description" %>
    <%= f.text_area :description, rows: 6, maxlength: 5000, placeholder: "What this space is about — for a team space, what it takes care of. Background, constraints, people, links." %>
  </div>
  <div class="field">
    <%= f.label :working_dir, "Working folder (optional)" %>
    <div class="folder-picker" data-folders-url="<%= folders_spaces_path %>">
      <%= f.text_field :working_dir, maxlength: 1000, autocapitalize: "none", autocomplete: "off", spellcheck: false, placeholder: "~/Code/project — start typing",
                       role: "combobox", "aria-autocomplete": "list", "aria-expanded": "false", "aria-controls": "folder-suggestions" %>
      <ul class="folder-suggestions" id="folder-suggestions" role="listbox" hidden></ul>
      <span class="folder-status small" data-folder-status aria-live="polite"></span>
    </div>
    <span class="hint">A folder on this computer. Every step of this space runs there: agents edit its files, run tools (git, Docker) and use the network. They cannot read other spaces' folders. Agents on Codex can read other folders.</span>
  </div>
  <div class="field">
    <%= f.label :autonomy_level, "Autonomy" %>
    <%= f.select :autonomy_level, [ [ "Your default (#{Autonomy.name(current_user.autonomy_level)})", "" ] ] + Autonomy::LEVELS.map { |level, name| [ "#{level} · #{name}", level ] } %>
    <span class="hint">How often agents ask you in this space. Pytaj: they ask before planning and the plan waits for your approval. Ważne pytaj: they ask about important things. Decyduj: they decide and write down what they assumed. Sending, paying, deleting outside the run's folder, pushing and passwords are always asked.</span>
  </div>
  <div class="field">
    <%= f.label :work_tempo, "Tempo" %>
    <%= f.select :work_tempo, [ [ "Your default (#{WorkTempo.name(current_user.work_tempo)})", "" ] ] + WorkTempo::LEVELS.map { |level, name| [ "#{level} · #{name}", level ] } %>
    <span class="hint">How new work in this space is split into steps. Dokładnie: smaller steps, the last one checks the work. Normalnie: as the task needs. Turbo: one step for one agent, no clarifying questions.</span>
  </div>
  <div class="actions"><%= f.submit space.persisted? ? "Save changes" : "Create space" %><%= link_to "Cancel", (space.persisted? ? space_path(space) : spaces_path), class: "button secondary" %></div>
<% end %>
