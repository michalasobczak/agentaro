<% content_for :content_class, "full" %>
<% content_for :scripts do %><%= javascript_include_tag "kanban", defer: true %><% end %>
<%= breadcrumbs(*space_crumbs(@space)) %>
<%= page_header @space.name, [ (@space.project? ? "Project space" : "Team space"), @space.purpose ].compact.join(" · ") do %>
  <%= link_to "Edit", edit_space_path(@space), class: "button secondary" %>
  <% if @space.active? %>
    <%= button_to "Archive", archive_space_path(@space), method: :patch, class: "secondary", form: { data: { confirm: "Archive #{@space.name}? The director will take up none of its epics until you make it active again." } } %>
  <% else %>
    <%= button_to "Make active", activate_space_path(@space), method: :patch, class: "secondary" %>
  <% end %>
  <% if !@space.active? %>
    <%= button_to "Delete", space_path(@space), method: :delete, class: "danger", form: { data: { confirm: space_delete_confirmation(@space) } } %>
  <% elsif @space.work_items.none? %>
    <%= button_to "Delete", space_path(@space), method: :delete, class: "danger", form: { data: { confirm: "Delete #{@space.name}?" } } %>
  <% end %>
<% end %>
<div hidden data-refresh-url="<%= stamp_director_path %>" data-refresh-stamp="<%= ChangeStamp.management(current_user) %>"></div>
<% unless @space.active? %><div class="callout"><%= icon(:info) %><div>This space is archived: no new epics, and the director takes up none of its epics.</div></div><% end %>
<% if @space.working_dir %><p class="small muted space-folder"><%= icon(:chip, css: "icon tiny") %> Working folder: <code><%= @space.working_dir %></code> <%= git_line(@space) %></p><% end %>
<%= render "spaces/ci", space: @space if @space.working_dir %>
<% if @space.description.present? %>
  <details class="card space-about"><summary>About this space</summary><p class="pre"><%= @space.description %></p></details>
<% end %>

<div class="kanban" data-order-url="<%= order_space_path(@space) %>">
  <% { "new" => "New", "planned" => "Planned", "running" => "Running", "blocked" => "Blocked", "done" => "Done" }.each do |state, label| %>
    <section class="kanban-col s-<%= state %>" aria-label="<%= label %>">
      <header class="kanban-col-head"><span><%= label %></span><span class="count-pill"><%= @columns[state].size %></span></header>
      <ol class="kanban-cards" data-state="<%= state %>">
        <% @columns[state].each do |item| %>
          <% chain = item.epic_steps.to_a %>
          <% steps = chain.presence || item.tasks.sort_by(&:starts_at) %>
          <% ran = chain.any? ? chain.count { |s| s.state == "succeeded" } : steps.count { |t| t.runs.max_by(&:id)&.state == "succeeded" } %>
          <% current = chain.find { |s| %w[queued running].include?(s.state) } %>
          <li class="kanban-card<%= " is-high" if item.priority == "high" %>" data-id="<%= item.id %>" draggable="true" tabindex="0" aria-label="<%= item.title %>">
            <%= link_to item.title, work_item_path(item), class: "kanban-title", draggable: "false" %>
            <div class="kanban-meta small muted">
              <% if item.priority == "high" %><%= badge("high", "warn") %><% end %>
              <% if item.due_on %><span>due <%= l item.due_on, format: :short %></span><% end %>
              <% if steps.any? %><span><%= ran %>/<%= steps.size %> steps done</span><% end %>
              <% if current %><span class="kanban-now">step <%= current.position %> of <%= chain.size %> <%= current.state %></span>
              <% elsif item.state == "planned" && item.started_at.nil? %><span>starts <%= epic_start_label(item, short: true) %></span><% end %>
            </div>
            <% if steps.any? %><div class="kanban-progress" aria-hidden="true"><% steps.each do |t| %><span class="<%= t.is_a?(EpicStep) ? "run-#{t.state.tr("_", "-")}" : run_class_for_step(t) %>"></span><% end %></div><% end %>
            <% if item.state == "blocked" && item.blocked_reason.present? %><p class="kanban-note small"><%= item.blocked_reason.truncate(160) %></p><% end %>
            <% if item.state == "planned" && (holder = item.waits_for) %><p class="kanban-note small">Waits for “<%= holder.title.truncate(80) %>” in this space</p><% end %>
            <% unless item.state == "done" %>
              <div class="kanban-actions">
                <%= button_to "Done", done_work_item_path(item), class: "secondary small" %>
                <%= button_to "Cancel", cancel_work_item_path(item), class: "link small", form: { data: { confirm: "Cancel \"#{item.title}\"? Its steps that have not started are removed." } } %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ol>
      <% if @columns[state].empty? %><p class="kanban-empty small muted"><%= { "new" => "Tell the director what needs doing.", "planned" => "Nothing waiting to start.", "running" => "Nothing running.", "blocked" => "Nothing stuck.", "done" => "Nothing finished yet." }[state] %></p><% end %>
    </section>
  <% end %>
</div>
<p class="small muted desktop-only kanban-hint">Drag cards up and down to set their order (or focus a card and press Alt + ↑ / ↓). New epics come from your chat with the director.</p>
<% if @cancelled.any? %>
  <details class="card kanban-cancelled"><summary>Cancelled (<%= @cancelled.size %>)</summary>
    <ul class="rows"><% @cancelled.each do |item| %><li><%= link_to item.title, work_item_path(item), class: "row-link" %></li><% end %></ul>
  </details>
<% end %>
<%# Spec 034: this space's recurring orders. %>
<% orders = @space.recurring_orders.includes(:work_items).order(:id).to_a %>
<div class="card recurring-space" id="recurring">
  <div class="card-header"><h2>Recurring</h2><%= link_to "New recurring order", new_recurring_order_path(space_id: @space.id), class: "button secondary" %></div>
  <% if orders.empty? %>
    <p class="muted small">Nothing repeats here yet. Ask the director, for example “co poniedziałek o 8 przejrzyj backupy w <%= @space.name %>”.</p>
  <% else %>
    <ul class="recurring-list"><% orders.each do |order| %><%= render "recurring_orders/order", order: order %><% end %></ul>
  <% end %>
</div>
