<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Agentaro" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Agentaro">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
    <%# Spec 020: Turbo swaps page bodies, so the floating chat (and voice mode) survives moving between pages. %>
    <%= javascript_include_tag "turbo.min", type: "module" %>
    <%= javascript_include_tag "app", defer: true %>
    <% if signed_in? %><%= javascript_include_tag "notices", defer: true %><% end %>
    <%= yield :scripts %>
    <% if (dock_director = chat_dock_director) %><%= javascript_include_tag "chat", defer: true %><% end %>
  </head>

  <%# Owner fix ("potrzebuję też dark mode"): on body, which Turbo swaps on every visit, so a new choice applies at once. %>
  <body data-theme="<%= signed_in? ? current_user.theme : "auto" %>" data-chat-background="<%= signed_in? ? current_user.shown_chat_background : User::DEFAULT_CHAT_BACKGROUND %>">
    <div class="app">
      <% if signed_in? %>
        <% admin_nav = capture do %>
          <div class="nav-label desktop-only">Admin</div>
          <%= nav_link "Users", admin_users_path, :users, active: controller_path == "admin/users" || controller_path == "admin/password_links", css: "desktop-only" %>
          <%= nav_link "Audit log", admin_audit_events_path, :log, css: "desktop-only" %>
          <%= nav_link "Data changes", admin_data_changes_path, :history, css: "desktop-only" %>
        <% end %>
        <% main_nav = capture do %>
          <%= nav_link "Home", root_path, :home %>
          <%= nav_link "Calendar", calendar_path, :calendar, active: controller_path.in?(%w[calendar tasks]) %>
          <%= nav_link "Director", director_path, :chat, active: controller_path.in?(%w[directors chat_messages]) %>
          <%= nav_link "Spaces", spaces_path, :board, active: controller_path.in?(%w[spaces work_items]) %>
          <%= nav_link "Team", team_path, :org, active: controller_path.in?(%w[teams team_roles]) %>
          <%= nav_link "Agents", agents_path, :agent, active: controller_path == "agents" %>
          <%= nav_link "Executors", executors_path, :chip, active: controller_path.in?(%w[executors admin/executors]) %>
          <%= nav_link "My sessions", account_sessions_path, :sessions %>
          <% unless current_user.admin? %><%= nav_link "Password", edit_account_password_path, :key %><% end %>
          <%= admin_nav if current_user.admin? %>
        <% end %>

        <aside class="sidebar">
          <%= link_to root_path, class: "brand" do %><span class="brand-mark">A</span>Agentaro<% end %>
          <nav class="nav" aria-label="Main"><%= main_nav %></nav>
          <%= render "layouts/theme_switch" %>
          <div class="sidebar-footer">
            <span class="avatar"><%= initials(current_user) %></span>
            <div class="who"><strong><%= current_user.username %></strong><span><%= current_user.role %></span></div>
            <%= button_to session_path, method: :delete, class: "icon-button", title: "Sign out", "aria-label": "Sign out", form: { data: { turbo: false } } do %><%= icon(:logout) %><% end %>
          </div>
        </aside>

        <header class="topbar">
          <%= link_to root_path, class: "brand" do %><span class="brand-mark">A</span>Agentaro<% end %>
          <details>
            <summary aria-label="Menu"><%= icon(:menu) %></summary>
            <div class="menu">
              <div class="who"><strong><%= current_user.username %></strong><span><%= current_user.role %></span></div>
              <nav class="nav" aria-label="Main"><%= main_nav %></nav>
              <%= render "layouts/theme_switch" %>
              <%= button_to "Sign out", session_path, method: :delete, class: "secondary", form: { data: { turbo: false } } %>
            </div>
          </details>
        </header>
      <% end %>

      <main class="main">
        <div class="content <%= yield(:content_class) %>">
          <% flash.each do |type, message| %>
            <div class="flash <%= type %>" role="status"><%= message %></div>
          <% end %>
          <%= yield %>
        </div>
      </main>
    </div>
    <%= render "directors/dock", director: dock_director if dock_director %>
    <%# Spec 026: notices of blocked epics, on every page (kept across Turbo visits). %>
    <% if signed_in? %><div id="notice-stack" class="notice-stack" data-notices data-url="<%= notices_path %>" data-turbo-permanent aria-live="polite"></div><% end %>
  </body>
</html>
