<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Agentaro" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Agentaro">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <header class="top">
      <strong class="brand">Agentaro</strong>
      <% if signed_in? %>
        <nav>
          <%= link_to "Home", root_path %>
          <%= link_to "My sessions", account_sessions_path %>
          <% unless current_user.admin? %><%= link_to "Password", edit_account_password_path %><% end %>
          <% if current_user.admin? %>
            <%= link_to "Users", admin_users_path %>
            <%= link_to "Audit log", admin_audit_events_path %>
            <%= link_to "Data changes", admin_data_changes_path %>
          <% end %>
        </nav>
        <span class="who"><%= current_user.username %> (<%= current_user.role %>)</span>
        <%= button_to "Sign out", session_path, method: :delete, class: "link" %>
      <% end %>
    </header>

    <main>
      <% flash.each do |type, message| %>
        <p class="flash <%= type %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
