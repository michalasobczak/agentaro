<% unless @run.finished? %><div hidden data-refresh-url="<%= stamp_task_run_path(@run) %>" data-refresh-stamp="<%= ChangeStamp.run(@run) %>" data-refresh-every="5"></div><% end %>
<% run_label = "Run, #{l(@run.created_at, format: :short)}" %>
<% if @task %>
  <% if (crumbs = step_crumbs(@task)) %><%= breadcrumbs(*crumbs, [ run_label ]) %><% end %>
  <%= page_header "Run of #{@task.title}", "#{l @run.occurrence_start.in_time_zone, format: :long} · #{@run.trigger}" do %>
    <%= link_to "Back to task", (@task.editable_by?(current_user) ? edit_task_path(@task, occurrence: (@run.occurrence_start.iso8601 if @task.recurring?)) : task_path(@task, occurrence: (@run.occurrence_start.iso8601 if @task.recurring?))), class: "button secondary" %>
  <% end %>
<% else %>
  <%# Spec 011/012: a management run — the director (or, before spec 012, a manager) answering in JSON. %>
  <% if @run.work_item %><%= breadcrumbs(*epic_crumbs(@run.work_item), [ run_label ]) %><% end %>
  <%= page_header(@run.purpose == "chat" ? "Director answering you" : "Run: #{run_purpose_label(@run)}", [ @run.work_item&.title, l(@run.created_at, format: :long) ].compact.join(" · ")) do %>
    <%= link_to (@run.work_item ? "Back to the epic" : "Back to the chat"), (@run.work_item ? work_item_path(@run.work_item) : director_path), class: "button secondary" %>
  <% end %>
<% end %>
<div class="card">
  <dl class="facts">
    <dt>State</dt><dd><%= run_badge(@run) %><% unless @run.finished? %> <span class="muted small">This page refreshes by itself.</span><% end %></dd>
    <% if @run.agent_name %><dt>Agent</dt><dd><%= @run.agent_name %></dd><% end %>
    <% if @run.executor_name %><dt>Executor</dt><dd><%= [ @run.executor_name, @run.model ].compact.join(" · ") %></dd><% end %>
    <dt>Queued</dt><dd><%= l @run.created_at, format: :long %><% if @run.requested_by %> <span class="muted small">by <%= @run.requested_by %></span><% end %></dd>
    <% if @run.started_at %><dt>Started</dt><dd><%= l @run.started_at, format: :long %></dd><% end %>
    <% if @run.duration %><dt>Took</dt><dd><%= distance_of_time_in_words(@run.duration) %> (<%= @run.duration.round %> s)</dd><% end %>
    <% if @run.exit_status %><dt>Exit status</dt><dd><%= @run.exit_status %></dd><% end %>
  </dl>
</div>
<% if @run.output %>
  <div class="card"><div class="card-header"><h2>Answer</h2></div><pre class="run-text"><%= @run.output %></pre></div>
<% end %>
<% if @run.error %>
  <div class="card"><div class="card-header"><h2><%= @run.ok? ? "Messages" : "Error" %></h2></div><pre class="run-text"><%= @run.error %></pre></div>
<% end %>
<% if @run.prompt %>
  <details class="card"><summary><strong>Prompt sent to the agent</strong></summary><pre class="run-text"><%= @run.prompt %></pre></details>
<% end %>
<%# Spec 030, G7: the run's trace — each model call with its numbers, prompt parts and tool events (desktop only). %>
<% calls = @run.model_calls.includes(:output_part, parts: :trace_part).to_a %>
<% if calls.any? %>
  <section class="card desktop-only run-trace">
    <div class="card-header"><h2>Trace</h2></div>
    <% calls.each do |call| %>
      <details class="trace-call">
        <summary>
          <strong>Call <%= call.position %> · <%= call.pass %></strong>
          <span class="muted small"><%= trace_call_summary(call) %></span>
        </summary>
        <% if call.redacted %><p class="hint">Secrets were removed from this trace before it was stored.</p><% end %>
        <h3 class="trace-heading">Prompt<%= " (from before traces, as one text)" if call.layout == "legacy" %></h3>
        <ol class="trace-parts">
          <% call.parts.each do |part| %>
            <li>
              <details>
                <summary><span class="badge"><%= part.kind.tr("_", " ") %></span> <span class="muted small"><%= number_to_human_size(part.trace_part.bytes) %></span>
                  <span class="trace-preview"><%= part.trace_part.content.squish.truncate(90) %></span></summary>
                <pre class="run-text"><%= part.trace_part.content %></pre>
              </details>
            </li>
          <% end %>
        </ol>
        <% events = call.event_list %>
        <% if events.any? %>
          <h3 class="trace-heading">What it did (<%= pluralize(events.size, "event") %><%= ", more were left out" if call.events_cut %>)</h3>
          <ol class="trace-events">
            <% events.each do |event| %>
              <li>
                <details>
                  <summary><span class="badge"><%= event["kind"].to_s.tr("_", " ") %></span> <%= event["name"] %>
                    <% if event["source"] %><span class="muted small">from <%= event["source"] %></span><% end %>
                    <% if event["error"] %><span class="badge bad">error</span><% end %></summary>
                  <pre class="run-text"><%= event["input"] || event["content"] || event["text"] %></pre>
                </details>
              </li>
            <% end %>
          </ol>
        <% end %>
        <% if call.answer %>
          <h3 class="trace-heading">Answer of this call</h3>
          <pre class="run-text"><%= call.answer %></pre>
        <% end %>
      </details>
    <% end %>
  </section>
  <%= desktop_only_note %>
<% end %>
