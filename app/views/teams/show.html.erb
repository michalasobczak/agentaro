<%= page_header "Team", "Who works for you: the director you talk to, who plans the work, and the members who do the steps." %>
<% content_for :scripts do %><%= javascript_include_tag "team_status", defer: true %><% end %>
<% role_badge_for = ->(agent) { agent.usable? ? nil : badge("not available", "warn") } %>
<%# Spec 023: busy or free per agent (G3); team_status.js updates the badges in place (G5). %>
<% status_for = ->(agent) { agent_status_badge(@statuses[agent.id] || { id: agent.id, status: "free", label: "free", show_dot: true, activities: [] }) } %>

<div class="card org-card" data-status-url="<%= status_team_path %>" data-status-stamp="<%= @team_status[:stamp] %>">
  <div class="card-header"><h2>Org chart</h2></div>
  <% if @director.nil? && @members.empty? %>
    <p class="muted">No team yet. Choose a director below, then add members with their roles.</p>
  <% else %>
    <ul class="org">
      <li>
        <div class="org-node is-director">
          <span class="org-role">Director</span>
          <% if @director %>
            <%= agent_icon(agent_icon_letter(@director.agent.name), kind: "director", size: "strip", agent_id: @director.agent_id, status: @statuses[@director.agent_id]) %>
            <strong><%= @director.agent.name %></strong> <%= role_badge_for.(@director.agent) %>
            <span class="muted small"><%= @director.agent.runtime_label %></span>
            <%= status_for.(@director.agent) %>
          <% else %>
            <span class="muted">not chosen</span>
          <% end %>
        </div>
        <% if @verifier %>
          <div class="org-node is-verifier">
            <span class="org-role">Verifier</span>
            <%= agent_icon(agent_icon_letter(@verifier.agent.name), kind: "verifier", size: "strip", agent_id: @verifier.agent_id, status: @statuses[@verifier.agent_id]) %>
            <strong><%= @verifier.agent.name %></strong> <%= role_badge_for.(@verifier.agent) %>
            <span class="muted small"><%= @verifier.agent.runtime_label %></span>
            <%= status_for.(@verifier.agent) %>
          </div>
        <% end %>
        <% if @members.any? %>
          <ul>
            <% @members.each do |member| %>
              <li>
                <div class="org-node">
                  <span class="org-role"><%= member.role_text || "Member" %></span>
                  <%= agent_icon(agent_icon_letter(member.agent.name), tone: agent_tone(member.agent), size: "strip", agent_id: member.agent_id, status: @statuses[member.agent_id]) %>
                  <strong><%= member.agent.name %></strong> <%= role_badge_for.(member.agent) %>
                  <span class="muted small"><%= member.agent.runtime_label %></span>
                  <%= status_for.(member.agent) %>
                </div>
              </li>
            <% end %>
          </ul>
        <% end %>
      </li>
    </ul>
  <% end %>
</div>

<% agent_options = @candidates.map { |a| [ "#{a.name}#{" (shared)" if a.shared?}#{" — not available" unless a.usable?}", a.id ] } %>
<% if @candidates.empty? %>
  <div class="card"><p class="muted">You have no agents yet. <%= link_to "Create an agent", new_agent_path %> first.</p></div>
<% else %>
  <div class="grid grid-2 team-forms">
    <div class="card">
      <div class="card-header"><h2>Director</h2></div>
      <% if @director %>
        <p><strong><%= @director.agent.name %></strong> is your director: you talk to it, and it plans your items for the members.</p>
        <%= button_to "Change director", team_role_path(@director), method: :delete, class: "secondary", form: { data: { confirm: "Remove #{@director.agent.name} as director? You can then choose another." } } %>
      <% else %>
        <%= form_with model: TeamRole.new, url: team_roles_path, class: "form" do |f| %>
          <%= f.hidden_field :role, value: "director" %>
          <div class="field"><%= f.label :agent_id, "Agent" %><%= f.select :agent_id, agent_options %></div>
          <div><%= f.submit "Make director" %></div>
        <% end %>
      <% end %>
    </div>
    <div class="card">
      <div class="card-header"><h2>Verifier</h2></div>
      <%# Spec 019: a second model you can ask in the chat to check the director; it only comments. %>
      <% if @verifier %>
        <p><strong><%= @verifier.agent.name %></strong> checks the director when you press "Ask the verifier" in the chat. It only comments.</p>
        <%= button_to "Change verifier", team_role_path(@verifier), method: :delete, class: "secondary", form: { data: { confirm: "Remove #{@verifier.agent.name} as verifier?" } } %>
      <% else %>
        <p class="muted small">A second model you ask, in the chat, to check what the director says. Choose an agent on another model than the director's — e.g. Codex when the director runs on Claude.</p>
        <%= form_with model: TeamRole.new, url: team_roles_path, class: "form" do |f| %>
          <%= f.hidden_field :role, value: "verifier" %>
          <div class="field"><%= f.label :agent_id, "Agent" %><%= f.select :agent_id, agent_options %></div>
          <div><%= f.submit "Make verifier" %></div>
        <% end %>
      <% end %>
    </div>
    <div class="card">
      <div class="card-header"><h2>Add a member</h2></div>
      <%= form_with model: TeamRole.new, url: team_roles_path, class: "form" do |f| %>
        <%= f.hidden_field :role, value: "member" %>
        <div class="field"><%= f.label :agent_id, "Agent" %><%= f.select :agent_id, agent_options %></div>
        <div class="field"><%= f.label :role_text, "Role" %><%= f.text_field :role_text, maxlength: 100, placeholder: "e.g. researcher" %></div>
        <div><%= f.submit "Add member" %></div>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2>Members</h2></div>
    <% if @members.any? %>
      <ul class="rows member-rows">
        <% @members.each do |member| %>
          <li class="member-row">
            <%= agent_icon(agent_icon_letter(member.agent.name), tone: agent_tone(member.agent), size: "strip", agent_id: member.agent_id, status: @statuses[member.agent_id]) %>
            <strong><%= member.agent.name %></strong>
            <%= status_for.(member.agent) %>
            <%= form_with model: member, url: team_role_path(member), method: :patch, class: "inline-form" do |f| %>
              <%= f.text_field :role_text, maxlength: 100, placeholder: "Role, e.g. researcher", "aria-label": "Role of #{member.agent.name}" %>
              <%= f.submit "Save", class: "secondary small" %>
            <% end %>
            <%= button_to "Remove", team_role_path(member), method: :delete, class: "link", form: { data: { confirm: "Remove #{member.agent.name} from your team?" } } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted small">No members yet. The director plans steps only for members.</p>
    <% end %>
  </div>
<% end %>
