<%= page_header "Data changes", "Every create, update and delete with who and when, kept for 3 months. Secrets show as [FILTERED]." %>
<%= desktop_only_note %>
<div class="card card-flush desktop-only">
  <%= form_with url: admin_data_changes_path, method: :get, class: "filters" do |f| %>
    <div class="field"><%= f.label :record_type, "Type" %><%= f.text_field :record_type, value: params[:record_type] %></div>
    <div class="field"><%= f.label :record_id, "ID" %><%= f.text_field :record_id, value: params[:record_id], inputmode: "numeric" %></div>
    <div class="field"><%= f.label :actor %><%= f.text_field :actor, value: params[:actor] %></div>
    <div class="actions"><%= f.submit "Filter", name: nil %><%= link_to "Clear", admin_data_changes_path, class: "button secondary" %></div>
  <% end %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Time</th><th>Actor</th><th>Record</th><th>Action</th><th>Changes</th><th></th></tr></thead>
      <tbody>
        <% @changes.each do |c| %>
          <tr>
            <td class="nowrap"><%= l c.occurred_at, format: :short %></td>
            <td class="mono"><%= c.actor %></td>
            <td class="nowrap"><%= link_to "#{c.record_type} ##{c.record_id}", admin_data_changes_path(record_type: c.record_type, record_id: c.record_id) %></td>
            <td><%= badge(c.action, { "create" => "ok", "update" => "accent", "destroy" => "bad" }[c.action]) %></td>
            <td class="wrap">
              <% c.changes_hash.each do |field, (before, after)| %>
                <div class="change-row"><strong><%= field %></strong> <span class="muted"><%= before.inspect %></span><span class="arrow">→</span><%= after.inspect %></div>
              <% end %>
            </td>
            <td class="nowrap"><%= c.request_id ? link_to("request", admin_audit_events_path(request_id: c.request_id), class: "small") : "—" %></td>
          </tr>
        <% end %>
        <% if @changes.empty? %><tr><td colspan="6" class="empty">No changes match.</td></tr><% end %>
      </tbody>
    </table>
  </div>
</div>
<% if @changes.size == Admin::DataChangesController::PAGE %>
  <p class="desktop-only spaced"><%= link_to "Older changes →", admin_data_changes_path(request.query_parameters.merge(before: @changes.last.id)), class: "button secondary" %></p>
<% end %>
