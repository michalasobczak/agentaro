<%= page_header "New user", "You will get a one-time link for the user to set their own password — nobody else ever knows it." %>
<%= desktop_only_note %>
<div class="card desktop-only">
  <% if @user.errors.any? %><ul class="errors"><% @user.errors.full_messages.each do |e| %><li><%= e %></li><% end %></ul><% end %>
  <%= form_with model: @user, url: admin_users_path, class: "form" do |f| %>
    <div class="field">
      <%= f.label :username %>
      <%= f.text_field :username, required: true, autocapitalize: "none", spellcheck: false %>
      <span class="hint">3–32 characters: a–z, 0–9, dot, underscore, hyphen.</span>
    </div>
    <label class="check"><%= f.check_box :otp_required %><span>Require a verification code (TOTP) at sign-in<br><span class="hint">The user sets up an authenticator app at first sign-in.</span></span></label>
    <div class="actions"><%= f.submit "Create user" %><%= link_to "Cancel", admin_users_path, class: "button secondary" %></div>
  <% end %>
</div>
