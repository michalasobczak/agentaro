<h1>New user</h1>
<% if @user.errors.any? %><ul class="errors"><% @user.errors.full_messages.each do |e| %><li><%= e %></li><% end %></ul><% end %>
<%= form_with model: @user, url: admin_users_path, class: "stack" do |f| %>
  <label>Username <%= f.text_field :username, required: true, autocapitalize: "none" %></label>
  <label><span><%= f.check_box :otp_required %> Require a verification code (TOTP) at sign-in</span></label>
  <%= f.submit "Create user" %>
<% end %>
<p class="muted">You get a one-time link for the user to set their password. Nobody else ever knows it.</p>
