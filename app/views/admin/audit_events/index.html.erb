<h1>Audit log</h1>
<p class="muted">Every HTTP request, kept for 3 months. Sensitive values are filtered. Verify integrity with <code>bin/rails agentaro:audit:verify</code>.</p>
<%= form_with url: admin_audit_events_path, method: :get, class: "filters" do |f| %>
  <label>User <%= f.text_field :username, value: params[:username] %></label>
  <label>Path contains <%= f.text_field :path, value: params[:path] %></label>
  <label>Status <%= f.text_field :status, value: params[:status], size: 4 %></label>
  <%= f.submit "Filter", name: nil %>
<% end %>
<table>
  <tr><th>Time</th><th>User</th><th>Request</th><th>Status</th><th>ms</th><th>From</th><th>Body</th></tr>
  <% @events.each do |e| %>
    <tr>
      <td><%= l e.occurred_at, format: :short %></td>
      <td><%= e.username || "—" %></td>
      <td class="wrap"><%= e.http_method %> <%= e.path %><%= "?#{e.query}" if e.query.present? %></td>
      <td><%= e.status %></td>
      <td><%= e.duration_ms&.round %></td>
      <td><%= e.forwarded_for.presence || e.remote_addr %></td>
      <td class="wrap"><%= e.body.to_s.truncate(200) %> <%= link_to "changes", admin_data_changes_path(request_id: e.request_id) %></td>
    </tr>
  <% end %>
</table>
<% if @events.size == Admin::AuditEventsController::PAGE %>
  <p><%= link_to "Older", admin_audit_events_path(request.query_parameters.merge(before: @events.last.id)) %></p>
<% end %>
