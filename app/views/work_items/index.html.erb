<%= page_header "Epics", "Everything the director keeps for you, across your projects. Each project also has a board." do %>
  <%= link_to director_path, class: "button" do %><%= icon(:chat) %> Talk to the director<% end %>
<% end %>
<div hidden data-refresh-url="<%= stamp_director_path %>" data-refresh-stamp="<%= ChangeStamp.management(current_user) %>"></div>
<% if @projects.many? %>
  <nav class="filter-pills" aria-label="Project">
    <%= link_to "All", work_items_path, class: ("active" unless @project) %>
    <% @projects.each do |p| %><%= link_to p.name, work_items_path(project: p.id), class: ("active" if @project == p) %><% end %>
  </nav>
<% end %>
<div class="card card-flush">
  <% if @items.empty? %>
    <p class="muted padded spaced">No epics yet. Tell the director what needs doing.</p>
  <% else %>
    <ul class="rows">
      <% @items.each do |item| %>
        <li>
          <%= link_to work_item_path(item), class: "row-link" do %>
            <span class="row-main">
              <strong><%= item.title %></strong>
              <span class="muted small">"<%= [ item.project.name, ("high priority" if item.priority == "high"), ("from #{l item.handle_from, format: :short}" if item.handle_from), ("due #{l item.due_on, format: :long}" if item.due_on) ].compact.join(" · ") %></span>
            </span>
            <span class="row-meta"><%= item_state_badge(item) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
