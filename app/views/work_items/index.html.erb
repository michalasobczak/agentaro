<%= page_header "Your list", "What needs doing. Your director keeps this list from your conversation." do %>
  <%= link_to director_path, class: "button" do %><%= icon(:chat) %> Talk to the director<% end %>
<% end %>
<div hidden data-refresh-url="<%= stamp_director_path %>" data-refresh-stamp="<%= ChangeStamp.management(current_user) %>"></div>
<div class="card card-flush">
  <% if @items.empty? %>
    <p class="muted padded spaced">Nothing on the list yet. Tell the director what needs doing.</p>
  <% else %>
    <ul class="rows">
      <% @items.each do |item| %>
        <li>
          <%= link_to work_item_path(item), class: "row-link" do %>
            <span class="row-main">
              <strong><%= item.title %></strong>
              <span class="muted small"><%= [ ("high priority" if item.priority == "high"), ("from #{l item.handle_from, format: :short}" if item.handle_from), ("due #{l item.due_on, format: :long}" if item.due_on), (item.manager_agent && "manager: #{item.manager_agent.name}") ].compact.join(" · ") %></span>
            </span>
            <span class="row-meta"><%= item_state_badge(item) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
