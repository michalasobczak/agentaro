<%= breadcrumbs(*epic_crumbs(@item)) %>
<%= page_header @item.title, "Epic in #{@item.space.name}" do %>
  <%= link_to "Space board", space_path(@item.space), class: "button secondary" %>
<% end %>
<div hidden data-refresh-url="<%= stamp_director_path %>" data-refresh-stamp="<%= ChangeStamp.management(current_user) %>"></div>
<%= render "work_items/decisions", item: @item, decisions: @decisions %>
<div class="grid grid-2">
  <div class="card">
    <dl class="facts">
      <dt>Space</dt><dd><%= link_to @item.space.name, space_path(@item.space) %></dd>
      <% if @item.space.working_dir %><dt>Folder</dt><dd><code><%= @item.space.working_dir %></code></dd><% end %>
      <dt>State</dt><dd><%= item_state_badge(@item) %></dd>
      <dt>Priority</dt><dd><%= @item.priority %></dd>
      <dt>Start</dt><dd><%= epic_start_label(@item) %></dd>
      <% if @item.finished_at %><dt>Finished</dt><dd><%= l @item.finished_at, format: :long %></dd><% end %>
      <% if @item.due_on %><dt>Due</dt><dd><%= l @item.due_on, format: :long %></dd><% end %>
      <% if @item.description.present? %><dt>Details</dt><dd class="pre"><%= @item.description %></dd><% end %>
      <% if @item.plan_summary.present? %><dt>Plan</dt><dd class="pre"><%= @item.plan_summary %></dd><% end %>
      <% if @item.blocked_reason.present? && @item.state == "blocked" %><dt>Blocked</dt><dd class="pre"><%= @item.blocked_reason %></dd><% end %>
    </dl>
    <% unless %w[done cancelled].include?(@item.state) %>
      <div class="actions spaced">
        <% if @item.state == "blocked" && @decisions.none?(&:pending?) %><%= button_to "Try again", retry_work_item_path(@item), class: "secondary" %><% end %>
        <%= button_to "Done", done_work_item_path(@item), class: "secondary" %>
        <%= button_to "Cancel epic", cancel_work_item_path(@item), class: "link", form: { data: { confirm: "Cancel \"#{@item.title}\"? Its steps that have not started are removed." } } %>
      </div>
    <% end %>
  </div>
  <div class="card">
    <div class="card-header"><h2>Steps</h2></div>
    <% if @epic_steps.any? %>
      <ol class="epic-steps">
        <% @epic_steps.each do |step| %>
          <% run = step.last_run %>
          <li class="epic-step s-<%= step.state %>" id="step-<%= step.position %>">
            <div class="epic-step-head">
              <strong><%= step.title %></strong>
              <%= step_state_badge(step) %>
            </div>
            <div class="muted small"><%= step.agent&.name || "agent removed" %><% if run&.duration %> · <%= distance_of_time_in_words(run.duration) %><% end %><% if run %> · <%= link_to "run and answer", task_run_path(run) %><% end %></div>
            <% if step.description.present? %><p class="small pre"><%= step.description %></p><% end %>
          </li>
        <% end %>
      </ol>
    <% elsif @steps.empty? %>
      <p class="muted small">No steps yet.</p>
    <% else %>
      <ul class="run-list">
        <% @steps.each do |task| %>
          <% last = task.runs.max_by(&:id) %>
          <li><%= link_to edit_task_path(task) do %><span class="small"><%= l task.starts_at, format: :short %></span> <strong><%= task.title %></strong> <span class="muted small"><%= task.agent&.name %></span><% end %> <%= last ? run_badge(last) : badge("scheduled") %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
<div class="card">
  <div class="card-header"><h2>Management</h2></div>
  <% if @runs.empty? %>
    <p class="muted small">Not picked up yet.</p>
  <% else %>
    <ul class="run-list">
      <% @runs.each do |run| %>
        <li><%= link_to task_run_path(run) do %><%= run_badge(run) %> <span class="small"><%= run_purpose_label(run) %></span> <span class="muted small"><%= run.agent_name %> · <%= l run.created_at, format: :short %></span><% end %></li>
      <% end %>
    </ul>
  <% end %>
</div>
