<%= page_header "Welcome, #{current_user.username}", "Agentaro is ready. Agents, teams and the task calendar arrive in later specifications." %>

<div class="grid grid-stats">
  <div class="card stat">
    <span class="stat-icon"><%= icon(:sessions) %></span>
    <div><div class="stat-value"><%= current_user.sessions.current.count %></div><div class="stat-label">Active sessions</div></div>
  </div>
  <div class="card stat">
    <span class="stat-icon"><%= icon(:shield) %></span>
    <div><div class="stat-value"><%= current_user.otp_enrolled? ? "On" : "Off" %></div><div class="stat-label">Verification code (TOTP)</div></div>
  </div>
  <div class="card stat">
    <span class="stat-icon"><%= icon(:clock) %></span>
    <div><div class="stat-value"><%= l Current.session.expires_at, format: :short %></div><div class="stat-label">This session ends</div></div>
  </div>
  <% if current_user.admin? %>
    <div class="card stat desktop-only">
      <span class="stat-icon"><%= icon(:users) %></span>
      <div><div class="stat-value"><%= User.active.count %></div><div class="stat-label">Active users</div></div>
    </div>
  <% end %>
</div>

<div class="grid grid-2">
  <div class="card">
    <div class="card-header"><h2>Your account</h2><%= role_badge(current_user) %></div>
    <dl class="facts">
      <dt>Username</dt><dd><%= current_user.username %></dd>
      <dt>Password changed</dt><dd><%= current_user.password_changed_at ? l(current_user.password_changed_at, format: :long) : "—" %></dd>
      <dt>Signed in</dt><dd><%= l Current.session.created_at, format: :long %></dd>
    </dl>
    <div class="actions spaced">
      <%= link_to account_sessions_path, class: "button secondary" do %><%= icon(:sessions) %> My sessions<% end %>
      <% unless current_user.admin? %><%= link_to edit_account_password_path, class: "button secondary" do %><%= icon(:key) %> Change password<% end %><% end %>
    </div>
  </div>
  <% if current_user.admin? %>
    <div class="card desktop-only">
      <div class="card-header"><h2>Admin</h2></div>
      <p class="muted">Manage people and review what happened in the system.</p>
      <div class="actions">
        <%= link_to admin_users_path, class: "button" do %><%= icon(:users) %> Users<% end %>
        <%= link_to admin_audit_events_path, class: "button secondary" do %><%= icon(:log) %> Audit log<% end %>
        <%= link_to admin_data_changes_path, class: "button secondary" do %><%= icon(:history) %> Data changes<% end %>
      </div>
    </div>
  <% end %>
</div>
